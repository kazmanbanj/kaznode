<%- include('../includes/head.ejs') %>
<%- include('../includes/header.ejs') %>

<form action="/admin/<% if (editing) { %>edit-product<% } else { %>add-product<% } %>" method="POST" class="">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <fieldset class="uk-fieldset">

        <legend class="uk-legend">Add Product(s)</legend>

        <div class="uk-margin">
            <input class="uk-input uk-form-blank uk-form-width-large" type="text" name="title" placeholder="Click to Add Product" value="<% if (editing) { %><%=product.title%><% } %>">
        </div>

        <div class="uk-margin">
            <textarea class="uk-textarea uk-form-blank uk-form-width-large" rows="5" name="description" placeholder="Description"><% if (editing) { %><%=product.description%><% } %></textarea>
        </div>

        <div class="uk-margin">
            <input class="uk-input uk-form-blank uk-form-width-large" type="number" name="price" placeholder="Click to Add Price" step="0.01" value="<% if (editing) { %><%=product.price%><% } %>">
        </div>

        <div class="uk-margin">
            <input class="uk-input uk-form-blank uk-form-width-large" type="text" name="imageUrl" placeholder="Click to Add Image Url" value="<% if (editing) { %><%=product.imageUrl%><% } %>">
        </div>


        <% if (editing) { %>
            <input type="hidden" value="<%=product._id%>" name="productId" >
        <% } %>

        <button class="uk-button uk-button-primary">
            <% if (editing) { %>
                Update Product
            <% } else { %>
                <span uk-icon="icon: push"></span>
                Add Product
            <% } %>
        </button>

    </fieldset>
</form>

<%- include('../includes/foot.ejs') %>
