<div class="uk-card-body">
    <form action="/cart" method="post">
        <a href="/products/<%= product._id %>" class="uk-button uk-button-secondary">Details</a>
        <% if (isAuthenticated) { %>
            <button class="uk-button uk-button-primary" type="submit">Add to Cart</button>
        <% } %>
        <input type="hidden" name="productId" value="<%= product._id %>">
    </form>
</div>