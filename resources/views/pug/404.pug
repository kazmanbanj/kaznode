extends layout/main.pug

block content
    main
        div.uk-section-large
            div.uk-container.uk-container-large
                div(uk-grid="").uk-grid-collapse.uk-grid-match.uk-grid.uk-grid-stack
                    div.uk-width-1-.uk-width-1-3(@s)
                        div.uk-card.uk-card-default.uk-card-body.uk-text-center
                            img(src="https://freefrontend.com/assets/img/html-css-404-page-templates/HTML-404-Page-Animated.png", width="400", alt="")
                    div.uk-width-1-.uk-width-expand(@s)
                        div.uk-card.uk-card-primary.uk-card-body.uk-404-card-body
                            h3.uk-card-title It looks like you miscalculated something!
                            p This is
                                code 404 page.

                            div.uk-button-group
                                a.uk-button.uk-button-default.uk-button-small(href="javascript:history.back()")
                                    i.fa.fa-arrow-left Back
                                        a.uk-button.uk-button-defaul.uk-button-small(href="/")
                                            i.fa.fa-home home