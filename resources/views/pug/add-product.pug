extends layout/main.pug

block content
    form(action="/admin/add-product", method="POST", class="uk-margin")
        fieldset.uk-fieldset

            legend.uk-legend Add Product(s)

            div.uk-margin
                input.uk-input.uk-form-blank.uk-form-width-medium(type="text", name="title", placeholder="Click to Add Product")

            button.uk-button.uk-button-primary
                span(uk-icon="icon: push")