doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(http-equiv="X-UA-Compatible", content="IE=edge")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        link(rel="stylesheet", href="/css/main.css")
        link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/uikit/3.0.0-rc.14/css/uikit.min.css")
        script(src="https://cdnjs.cloudflare.com/ajax/libs/uikit/3.0.0-rc.14/js/uikit.min.js") 
        script(src="https://cdnjs.cloudflare.com/ajax/libs/uikit/3.0.0-rc.14/js/uikit-icons.min.js") 
        title #{docTitle}
    body 
        a(href="/") Shop from pug
        a(href="/admin/add-product") Add product

        if prods.length > 0
            div.uk-child-width-1-2(@muk-grid)
                each product in prods
                    div
                        div.uk-card.uk-card-default
                            div.uk-card-media-top
                                img(src="https://media.istockphoto.com/photos/string-light-bulbs-at-sunset-picture-id1300384615?b=1&k=20&m=1300384615&s=170667a&w=0&h=rkDm5TdJp_dU7VAknk4EuZEZ2ho2QQspOavjlwGrsuI=", width="800", height="200", alt="")
                            div.uk-card-body
                                h3.uk-card-title #{product.title}
                                p Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt.
        else 
            h1 No product yet.
